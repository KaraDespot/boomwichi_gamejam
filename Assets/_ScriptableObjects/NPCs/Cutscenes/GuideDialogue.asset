  - Lines:
    - Text: "\u041F\u0443\u0442\u044C \u0441\u0432\u043E\u0431\u043E\u0434\u0435\u043D."
      Guid:
        Value: 05b92379-4838-4c5d-bf1a-cc1846decc46
    - Text: "\u0422\u0435\u043F\u0435\u0440\u044C \u043C\u043E\u0436\u043D\u043E
