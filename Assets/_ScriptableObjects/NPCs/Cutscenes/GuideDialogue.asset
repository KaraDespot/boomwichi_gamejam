    Guid:
      Value: 8230363b-13c5-4d27-af6c-2ab4a7bac3a3
  - Lines:
    - Text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E. \u042F \u043F\u043E\u043D\u044F\u043B,
